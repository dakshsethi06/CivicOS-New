# Copy to .env for local development. On Render, set these in the service's Environment tab.

# Supabase -> Project Settings -> Database -> Connection string (URI). Use the pooler string ("Transaction pooler",
# port 6543) on hosts without IPv6, such as Render. Keep the password secret.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase -> Project Settings -> API (the same values as the web app's NEXT_PUBLIC_ ones)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Only if your project still uses the legacy JWT secret (Project Settings -> JWT Keys). Leave empty otherwise.
# SUPABASE_JWT_SECRET=

# Google Gemini (aistudio.google.com/apikey): writes answers and embeds documents.
# Without it the assistant shows the retrieved sources and search is keyword-only.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Vector database for document search. "pgvector" (default) searches inside Supabase. "qdrant" uses a separate
# Qdrant database (Qdrant Cloud free tier, or docker compose --profile vector locally); Postgres still keeps every
# chunk and vector, and every hit is re-checked there. After switching, run POST /v1/vector/sync once (no Gemini cost).
# VECTOR_STORE=qdrant
# QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333     (local: http://localhost:6333, in compose: http://qdrant:6333)
# QDRANT_API_KEY=
# QDRANT_COLLECTION=civicos_chunks

# Background jobs (training the water, waste and traffic models). With a Redis URL the API queues jobs for the
# Celery worker, which also retrains nightly; without one the API runs them itself. With docker compose's "jobs"
# profile this is set for you; for the API to queue jobs too, set it here as redis://redis:6379/0.
# REDIS_URL=
# ROUTE_SOLVER_SECONDS=3

# Origins allowed to call the API from a browser (the web app calls it from its server, so this is optional)
# CORS_ORIGINS=["http://localhost:3000"]
